# ============================================================
# Website CV Restu Bunda Mariyati — Environment Variables
# Salin file ini menjadi .env lalu isi dengan nilai asli.
# JANGAN pernah commit nilai asli ke repository.
# Daftar lengkap: PRD.md — Lampiran C.
# ============================================================

# --- Database PostgreSQL (Neon/Supabase) ---
# Connection string dengan pooling (pgbouncer, port 6543 di Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Connection string langsung (port 5432) untuk migrasi Prisma,
# wajib bila pakai connection pooling. Hapus jika tidak dipakai.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Better-Auth ---
# Secret untuk signing session/token. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL dasar aplikasi (dipakai Better-Auth untuk redirect & cookie).
BETTER_AUTH_URL="http://localhost:3000"

# URL publik aplikasi (client auth). Sama dengan URL produksi setelah deploy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Kontak WhatsApp publik (CTA booking katalog) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="6281355702680"
# Alamat kantor: Jl. Mawar No.c3/6, Pai, Kec. Biringkanaya, Kota Makassar, Sulawesi Selatan 90242
# Maps: https://maps.app.goo.gl/JEDBVHmRNrXJoC5x5
NEXT_PUBLIC_OFFICE_ADDRESS="Jl. Mawar No.c3/6, Pai, Kec. Biringkanaya, Kota Makassar, Sulawesi Selatan 90242"
NEXT_PUBLIC_OFFICE_MAPS_URL="https://maps.app.goo.gl/JEDBVHmRNrXJoC5x5"

# --- Cloudinary (penyimpanan dokumen & foto pekerja) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder default dipakai src/lib/cloudinary.ts (restu-bunda/workers/...).
# Upload dokumen sensitif wajib JPG/PNG maks 5 MB, foto profil JPG/PNG maks 2 MB — satu pipeline watermark.

# --- Email transaksional (Nodemailer + Gmail SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Alamat pengirim yang tampil di kotak masuk (default: SMTP_USER bila kosong).
SMTP_FROM=""

# --- Cron Daily Automation Job (wajib divalidasi di route cron) ---
CRON_SECRET=""

# --- Seeder bootstrap Super Admin (lihat PRD §7.1) ---
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
